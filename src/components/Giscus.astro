---

export interface Props {
	repo?: string;
	repoId?: string;
	category?: string;
	categoryId?: string;
	mapping?: string;
	strict?: string;
	reactionsEnabled?: string;
	emitMetadata?: string;
	inputPosition?: string;
	lang?: string;
}

const {
	repo = "SilonGJ/blog",
	repoId = "R_kgDOTlEalA",
	category = "giscus",
	categoryId = "DIC_kwDOTlEalM4DC8DC",
	mapping = "pathname",
	strict = "1",
	reactionsEnabled = "0",
	emitMetadata = "0",
	inputPosition = "top",
	lang = "zh-CN",
} = Astro.props;
---

<div class="card-base px-6 md:px-9 py-4 md:py-6">
    <h2 class="relative mb-4">
        <div
            class="transition w-full block font-bold
            text-xl md:text-2xl
            text-90
            before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
            before:absolute before:top-[0.5rem] before:left-[-1.125rem]"
        >
            评论
        </div>
    </h2>
    <giscus-widget
        id="giscus-comments"
        repo={repo}
        repoid={repoId}
        category={category}
        categoryid={categoryId}
        mapping={mapping}
        strict={strict}
        reactionsenabled={reactionsEnabled}
        emitmetadata={emitMetadata}
        inputposition={inputPosition}
        lang={lang}
        loading="eager"
    ></giscus-widget>
    <script
        is:inline
        set:html={`(function () {
  // Runs during HTML parsing (and is re-run by swup after every page
  // transition), i.e. before the widget custom element is upgraded and renders
  // its iframe. Seeding the attribute here is what prevents a flash of the
  // light theme for dark-mode visitors.
  var el = document.getElementById('giscus-comments');
  if (!el) return;
  el.setAttribute(
    'theme',
    document.documentElement.classList.contains('dark')
      ? 'dark_tritanopia'
      : 'light_tritanopia'
  );
})();`}
    ></script>
</div>

<script>
import "giscus";
import type { GiscusWidget } from "giscus";

function themeName(): "dark_tritanopia" | "light_tritanopia" {
	return document.documentElement.classList.contains("dark")
		? "dark_tritanopia"
		: "light_tritanopia";
}

// The widget reflects the `theme` property into its iframe via postMessage and
// re-sends the whole config once the iframe has loaded, so it handles the
// "iframe not ready yet" race on its own — no timers needed here.
function syncGiscusTheme(): void {
	const el = document.querySelector<GiscusWidget>("giscus-widget");
	if (el && el.theme !== themeName()) {
		el.theme = themeName();
	}
}

syncGiscusTheme();
new MutationObserver(syncGiscusTheme).observe(document.documentElement, {
	attributes: true,
	attributeFilter: ["class"],
});
</script>

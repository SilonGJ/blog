---
import { siteUrl } from "@/config";

const GISCUS_THEME_BASE = new URL("giscus", siteUrl).href;

// All visual rules live in the CSS files below; this map only selects which
// pre-written file the iframe should load for the current blog preferences.
const GISCUS_THEMES = {
	"rounded-anim": {
		light: `${GISCUS_THEME_BASE}/light.css`,
		dark: `${GISCUS_THEME_BASE}/dark.css`,
	},
	"rounded-noanim": {
		light: `${GISCUS_THEME_BASE}/light-noanim.css`,
		dark: `${GISCUS_THEME_BASE}/dark-noanim.css`,
	},
	"norounded-anim": {
		light: `${GISCUS_THEME_BASE}/light-norounded.css`,
		dark: `${GISCUS_THEME_BASE}/dark-norounded.css`,
	},
	"norounded-noanim": {
		light: `${GISCUS_THEME_BASE}/light-norounded-noanim.css`,
		dark: `${GISCUS_THEME_BASE}/dark-norounded-noanim.css`,
	},
} as const;

const GISCUS_THEME_MAP = JSON.stringify(GISCUS_THEMES);

export interface Props {
	repo?: string;
	repoId?: string;
	category?: string;
	categoryId?: string;
	mapping?: string;
	strict?: string;
	reactionsEnabled?: string;
	emitMetadata?: string;
	inputPosition?: string;
	lang?: string;
}

const {
	repo = "SilonGJ/blog",
	repoId = "R_kgDOTlEalA",
	category = "giscus",
	categoryId = "DIC_kwDOTlEalM4DC8DC",
	mapping = "pathname",
	strict = "1",
	reactionsEnabled = "0",
	emitMetadata = "0",
	inputPosition = "top",
	lang = "zh-CN",
} = Astro.props;
---

<div class="card-base px-6 md:px-9 py-4 md:py-6">
    <h2 class="relative mb-4">
        <div
            class="transition w-full block font-bold
            text-3xl md:text-[2.25rem]/[2.75rem]
            text-90
            before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
            before:absolute before:top-[0.5rem] md:before:top-[0.75rem] before:left-[-1.125rem]"
        >
            评论
        </div>
    </h2>
    <giscus-widget
        id="giscus-comments"
        repo={repo}
        repoid={repoId}
        category={category}
        categoryid={categoryId}
        mapping={mapping}
        strict={strict}
        reactionsenabled={reactionsEnabled}
        emitmetadata={emitMetadata}
        inputposition={inputPosition}
        theme={GISCUS_THEMES["rounded-anim"].light}
        data-theme-map={GISCUS_THEME_MAP}
        lang={lang}
        loading="eager"
    ></giscus-widget>
    <script
        is:inline
        set:html={`(function () {
  // Runs during HTML parsing (and is re-run by swup after every page
  // transition), i.e. before the widget custom element is upgraded and renders
  // its iframe. Seeding the attribute here is what prevents a flash of the
  // light theme for dark-mode visitors.
  var el = document.getElementById('giscus-comments');
  if (!el) return;
  var map = {};
  try {
    map = JSON.parse(el.getAttribute('data-theme-map') || '{}');
  } catch {}
  var root = document.documentElement;
  var corners = root.classList.contains('no-rounded') ? 'norounded' : 'rounded';
  var motion = root.classList.contains('no-animations') ? 'noanim' : 'anim';
  var mode = root.classList.contains('dark') ? 'dark' : 'light';
  var pair = map[corners + '-' + motion];
  if (pair && pair[mode]) el.setAttribute('theme', pair[mode]);
})();`}
    ></script>
</div>

<script>
import "giscus";
import type { GiscusWidget } from "giscus";

type GiscusThemeMap = Record<string, { light: string; dark: string }>;

function themeName(el: GiscusWidget): string {
	const raw = el.getAttribute("data-theme-map");
	if (!raw) return "";

	let map: GiscusThemeMap;
	try {
		map = JSON.parse(raw) as GiscusThemeMap;
	} catch {
		return "";
	}

	const root = document.documentElement;
	const corners = root.classList.contains("no-rounded")
		? "norounded"
		: "rounded";
	const motion = root.classList.contains("no-animations")
		? "noanim"
		: "anim";
	const mode = root.classList.contains("dark") ? "dark" : "light";

	return map[`${corners}-${motion}`]?.[mode] ?? "";
}

// The widget reflects the `theme` property into its iframe via postMessage and
// re-sends the whole config once the iframe has loaded, so it handles the
// "iframe not ready yet" race on its own — no timers needed here.
function syncGiscusTheme(): void {
	const el = document.querySelector<GiscusWidget>("#giscus-comments");
	if (!el) return;

	const theme = themeName(el);
	if (theme && el.theme !== theme) {
		el.theme = theme;
	}
}

syncGiscusTheme();
new MutationObserver(syncGiscusTheme).observe(document.documentElement, {
	attributes: true,
	attributeFilter: ["class"],
});
</script>

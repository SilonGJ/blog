---
import { Icon } from "astro-icon/components";
---

<!-- Mouse: hover opens and leaving closes. Touch/pen: tap the button to toggle. -->
<div class="relative z-50" id="settings-switch-container">
    <button aria-label="Settings" aria-haspopup="true" class="relative btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="settings-switch">
        <Icon name="material-symbols:settings-outline-rounded" class="text-[1.25rem]"></Icon>
    </button>

    <div id="settings-panel" class="absolute transition float-panel-closed top-11 -right-2 pt-5">
        <div class="card-base float-panel p-2">
            <label class="mb-0.5 flex transition whitespace-nowrap items-center !justify-start w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95"
                   id="animation-toggle-label" for="animation-checkbox"
            >
                <input type="checkbox" class="checkbox-custom mr-3" id="animation-checkbox" />
                启用动画
            </label>
            <label class="flex transition whitespace-nowrap items-center !justify-start w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95"
                   id="rounded-toggle-label" for="rounded-checkbox"
            >
                <input type="checkbox" class="checkbox-custom mr-3" id="rounded-checkbox" />
                启用圆角
            </label>
        </div>
    </div>
</div>

<script>
import {
	ANIMATION_CHANGE_EVENT,
	isAnimationsEnabled,
	isRoundedEnabled,
	setAnimationsEnabled,
	setRoundedEnabled,
} from "@utils/setting-utils";

const settingsSwitch = document.getElementById("settings-switch");
const settingsPanel = document.getElementById("settings-panel");
const container = document.getElementById("settings-switch-container");

const toggles = [
	{
		id: "animation-checkbox",
		read: isAnimationsEnabled,
		write: setAnimationsEnabled,
	},
	{ id: "rounded-checkbox", read: isRoundedEnabled, write: setRoundedEnabled },
] as const;

function showPanel() {
	settingsPanel?.classList.remove("float-panel-closed");
}

function hidePanel() {
	settingsPanel?.classList.add("float-panel-closed");
}

function togglePanel() {
	settingsPanel?.classList.toggle("float-panel-closed");
}

// Initialize every checkbox from the stored preference (checked by default)
for (const { id, read, write } of toggles) {
	const checkbox = document.getElementById(id) as HTMLInputElement | null;
	if (!checkbox) continue;
	checkbox.checked = read();
	checkbox.addEventListener("change", () => {
		// The panel stays open so the user can switch back right away
		write(checkbox.checked);
	});
	// Keep the checkbox in sync with programmatic preference changes.
	document.addEventListener(ANIMATION_CHANGE_EVENT, () => {
		checkbox.checked = read();
	});
}

// Track the last pointer type so touch/pen taps can toggle the panel while a
// mouse still uses hover to open it. A touch tap also fires synthetic pointer
// events, so opening on `pointerenter` must be limited to actual mice.
let lastPointerType: PointerEvent["pointerType"] = "mouse";
settingsSwitch?.addEventListener("pointerdown", (event) => {
	lastPointerType = event.pointerType;
});

settingsSwitch?.addEventListener("pointerenter", (event) => {
	if (event.pointerType === "mouse") showPanel();
});
container?.addEventListener("pointerleave", (event) => {
	if (event.pointerType === "mouse") hidePanel();
});

settingsSwitch?.addEventListener("click", () => {
	if (lastPointerType === "touch" || lastPointerType === "pen") {
		togglePanel();
	} else {
		showPanel();
	}
});
</script>

---
import { Icon } from "astro-icon/components";

const searchPlaceholder = "搜索";
---

<!-- search bar for desktop view -->
<div id="search-bar" class="relative hidden lg:flex items-center h-11 mr-2 rounded-lg transition-[background-color]
      bg-black/[0.04] hover:bg-black/[0.06] focus-within:bg-black/[0.06]
      dark:bg-white/5 dark:hover:bg-white/10 dark:focus-within:bg-white/10
">
    <Icon name="material-symbols:search" class="absolute text-[1.25rem] pointer-events-none ml-3 transition my-auto text-black/75 dark:text-white/75"></Icon>
    <input id="search-input-desktop" placeholder={searchPlaceholder}
           class="pl-10 pr-9 text-sm bg-transparent outline-0
         h-full w-40 text-black/75 dark:text-white/75"
    >
    <button type="button" id="search-clear-desktop" aria-label="Clear Search"
            class="search-clear absolute right-1 top-1/2 -translate-y-1/2 w-7 h-7 items-center justify-center rounded-lg
                   transition text-black/40 hover:text-black/75 dark:text-white/40 dark:hover:text-white/75">
        <Icon name="material-symbols:close-rounded" class="text-[1.125rem]"></Icon>
    </button>
</div>

<!-- toggle btn for phone/tablet view -->
<button aria-label="Search Panel" id="search-switch"
        class="btn-plain scale-animation lg:!hidden rounded-lg w-11 h-11 active:scale-90">
    <Icon name="material-symbols:search" class="text-[1.25rem]"></Icon>
</button>

<!-- search panel wrapper (handles animation like light-dark panel) -->
<div id="search-panel" class="transition float-panel-closed absolute top-20 left-4 md:left-[unset] right-4 z-50">
    <!-- search panel (visual styling only) -->
    <div id="search-panel-inner" class="float-panel search-panel md:w-[30rem] rounded-2xl p-2">
        <!-- search bar inside panel for phone/tablet -->
        <div id="search-bar-inside" class="flex relative lg:hidden transition-all items-center h-11 rounded-xl
          bg-black/[0.04] hover:bg-black/[0.06] focus-within:bg-black/[0.06]
          dark:bg-white/5 dark:hover:bg-white/10 dark:focus-within:bg-white/10
      ">
            <Icon name="material-symbols:search" class="absolute text-[1.25rem] pointer-events-none ml-3 transition my-auto text-black/75 dark:text-white/75"></Icon>
            <input id="search-input-mobile" placeholder="搜索"
                   class="pl-10 pr-9 absolute inset-0 text-sm bg-transparent outline-0
                   text-black/75 dark:text-white/75"
            >
            <button type="button" id="search-clear-mobile" aria-label="Clear Search"
                    class="search-clear absolute right-1 top-1/2 -translate-y-1/2 w-7 h-7 items-center justify-center rounded-lg
                           transition text-black/40 hover:text-black/75 dark:text-white/40 dark:hover:text-white/75">
                <Icon name="material-symbols:close-rounded" class="text-[1.125rem]"></Icon>
            </button>
        </div>

        <!-- search results -->
        <div id="search-results"></div>
    </div>
</div>

<style>
  input:focus {
    outline: 0;
  }
  .search-panel {
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }
  .search-clear {
    display: none;
  }
  .search-clear.show {
    display: flex;
  }
</style>

<script>
	import { url } from "../utils/url-utils";

	type PagefindModule = NonNullable<Window["pagefind"]>;

	// Pagefind is loaded on first search intent instead of on page load, so the
	// empty-page cost of the search engine is zero. The loader lives here because
	// this component is its only consumer.
	//
	// swup re-executes every inline script in the document on each page view
	// (@swup/scripts-plugin, selector `script:not([data-swup-ignore-script])`,
	// scope = document), so the whole feature is guarded to run exactly once.
	if (!window.__searchInitialized) {
		window.__searchInitialized = true;

		const searchBar = document.getElementById("search-bar");
		const searchSwitch = document.getElementById("search-switch");
		const searchInputDesktop = document.getElementById("search-input-desktop") as HTMLInputElement | null;
		const searchInputMobile = document.getElementById("search-input-mobile") as HTMLInputElement | null;
		const searchPanel = document.getElementById("search-panel");
		const searchResults = document.getElementById("search-results");
		const searchClearDesktop = document.getElementById("search-clear-desktop");
		const searchClearMobile = document.getElementById("search-clear-mobile");

		let keywordDesktop = "";
		let keywordMobile = "";
		let result: any[] = [];
		let searchSeq = 0;
		let closeTimeout: ReturnType<typeof setTimeout> | null = null;

		const fakeResult = [
			{
				url: "/",
				meta: {
					title: "This Is a Fake Search Result",
				},
				excerpt:
					"Because the search cannot work in the <mark>dev</mark> environment.",
			},
			{
				url: "/",
				meta: {
					title: "If You Want to Test the Search",
				},
				excerpt: "Try running <mark>npm build && npm preview</mark> instead.",
			},
		];

		/* ---------- pagefind: on-demand, memoized ---------- */

		let pagefindPromise: Promise<PagefindModule> | null = null;

		function getPagefind(): Promise<PagefindModule> {
			if (!pagefindPromise) {
				pagefindPromise = import(/* @vite-ignore */ url("/pagefind/pagefind.js")).then(async (pf: PagefindModule) => {
					await pf.options({
						excerptLength: 20,
					});

					// Warm up the worker and the wasm module, but not the index,
					// so the first real search only has to fetch its index chunks.
					await pf.init();

					// Only expose it once it is actually usable: search() treats
					// this as the synchronous cold/warm check.
					window.pagefind = pf;

					return pf;
				});
			}

			return pagefindPromise;
		}

		// There is no pagefind bundle in the dev environment.
		const warmup = () => {
			if (!import.meta.env.DEV) void getPagefind().catch(() => {});
		};

		function togglePanel() {
			searchPanel?.classList.toggle("float-panel-closed");
		}

		function setPanelVisibility(show: boolean): void {
			if (!searchPanel) return;

			if (show) {
				searchPanel.classList.remove("float-panel-closed");
			} else {
				searchPanel.classList.add("float-panel-closed");
			}
		}

		function renderResults() {
			if (!searchResults) return;

			searchResults.innerHTML = "";

			result.forEach((item) => {
				const a = document.createElement("a");
				a.href = item.url;
				a.className = "transition first-of-type:mt-2 lg:first-of-type:mt-0 group block rounded-xl text-lg px-3 py-2 hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)]";

				a.innerHTML = `
			<div class="transition text-90 inline-flex font-bold group-hover:text-[var(--primary)]">
				${item.meta.title}
				<svg class="transition text-[0.75rem] translate-x-1 my-auto text-[var(--primary)]" viewBox="0 0 24 24" width="12" height="12">
					<path fill="currentColor" d="M8.59 16.58L13.17 12L8.59 7.41L10 6l6 6l-6 6z"/>
				</svg>
			</div>
			<div class="transition text-sm text-50">
				${item.excerpt}
			</div>
		`;

				searchResults!.appendChild(a);
			});
		}

		function renderMessage(text: string) {
			if (!searchResults) return;

			searchResults.innerHTML = `<div class="px-3 py-4 text-center text-sm text-50">${text}</div>`;
		}

		async function search(keyword: string): Promise<void> {
			if (!keyword) {
				setPanelVisibility(false);
				if (closeTimeout) clearTimeout(closeTimeout);
				closeTimeout = setTimeout(() => {
					result = [];
					renderResults();
				}, 160);
				return;
			}

			const seq = ++searchSeq;

			// Open the panel right away, even before any result exists.
			setPanelVisibility(true);

			try {
				let searchResultsData: any[] = [];

				if (import.meta.env.DEV) {
					searchResultsData = fakeResult;
				} else {
					let pf = window.pagefind;

					if (!pf) {
						renderMessage("加载中……");
						pf = await getPagefind();
					}

					// The user may have typed something else while we were waiting.
					if (seq !== searchSeq) return;

					const response = await pf.search(keyword);
					searchResultsData = await Promise.all(
						response.results.map((item) => item.data()),
					);
				}

				if (seq !== searchSeq) return;

				if (closeTimeout) {
					clearTimeout(closeTimeout);
					closeTimeout = null;
				}

				result = searchResultsData;

				if (searchResultsData.length > 0) {
					renderResults();
				} else {
					renderMessage("没有找到相关内容");
				}
			} catch (error) {
				if (seq !== searchSeq) return;

				console.error("Search error:", error);
				renderMessage("搜索暂时不可用，请稍后重试");
			}
		}

		/* ---------- clear buttons ---------- */

		function syncClearButtons() {
			searchClearDesktop?.classList.toggle("show", keywordDesktop.length > 0);
			searchClearMobile?.classList.toggle("show", keywordMobile.length > 0);
		}

		function bindClearButton(
			button: HTMLElement | null,
			input: HTMLInputElement | null,
			clear: () => void,
		) {
			button?.addEventListener("click", () => {
				if (input) input.value = "";
				clear();
				input?.focus();
			});
		}

		bindClearButton(searchClearDesktop, searchInputDesktop, () => {
			keywordDesktop = "";
			syncClearButtons();
			void search("");
		});

		bindClearButton(searchClearMobile, searchInputMobile, () => {
			keywordMobile = "";
			syncClearButtons();
			void search("");
		});

		/* ---------- inputs ---------- */

		if (searchInputDesktop) {
			searchInputDesktop.addEventListener("input", (e) => {
				keywordDesktop = (e.target as HTMLInputElement).value;
				syncClearButtons();
				void search(keywordDesktop);
			});
			searchInputDesktop.addEventListener("focus", () => {
				// The user is reaching for the search box: start loading now.
				warmup();
				void search(keywordDesktop);
			});
		}

		if (searchInputMobile) {
			searchInputMobile.addEventListener("input", (e) => {
				keywordMobile = (e.target as HTMLInputElement).value;
				syncClearButtons();
				void search(keywordMobile);
			});
		}

		searchSwitch?.addEventListener("click", togglePanel);

		/* ---------- load intents ---------- */

		searchBar?.addEventListener("pointerenter", warmup, { once: true });
		searchSwitch?.addEventListener("pointerdown", warmup, { once: true });

		/* ---------- keep the panel closed across page views ---------- */

		const closePanelOnNavigation = () => setPanelVisibility(false);

		const setupSwup = () => window.swup.hooks.on("visit:start", closePanelOnNavigation);

		if (window?.swup?.hooks) {
			setupSwup();
		} else {
			document.addEventListener("swup:enable", setupSwup);
		}

		syncClearButtons();
	}
</script>

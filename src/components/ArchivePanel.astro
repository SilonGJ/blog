---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Post {
	slug: string;
	data: {
		title: string;
		tags: string[];
		category?: string | null;
		published: Date;
	};
}

interface Group {
	year: number;
	posts: Post[];
}

interface Props {
	sortedPosts?: Post[];
}

const { sortedPosts = [] } = Astro.props;

// Group by year
const grouped = sortedPosts.reduce(
	(acc, post) => {
		const year = post.data.published.getFullYear();
		if (!acc[year]) {
			acc[year] = [];
		}
		acc[year].push(post);
		return acc;
	},
	{} as Record<number, Post[]>,
);

const groupedPostsArray = Object.keys(grouped).map((yearStr) => ({
	year: Number.parseInt(yearStr, 10),
	posts: grouped[Number.parseInt(yearStr, 10)],
}));

groupedPostsArray.sort((a, b) => b.year - a.year);

const groups: Group[] = groupedPostsArray;

function formatDate(date: Date) {
	const month = (date.getMonth() + 1).toString().padStart(2, "0");
	const day = date.getDate().toString().padStart(2, "0");
	return `${month}-${day}`;
}

function formatTag(tagList: string[]) {
	return tagList.map((t) => `#${t}`).join(" ");
}
---

<div class="card-base px-8 py-6" id="archive-panel"
     data-i18n-singular={i18n(I18nKey.postCount)}
     data-i18n-plural={i18n(I18nKey.postsCount)}
>
    {groups.map((group) => (
        <div class="archive-group" data-year={group.year}>
            <div class="flex flex-row w-full items-center h-[3.75rem]">
                <div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75 archive-year-count">
                    {group.year}
                </div>
                <div class="w-[15%] md:w-[10%]">
                    <div
                            class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto
                  -outline-offset-[2px] z-50 outline-3"
                    ></div>
                </div>
                <div class="w-[70%] md:w-[80%] transition text-left text-50 archive-year-posts-count">
                    {group.posts.length} {i18n(group.posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}
                </div>
            </div>

            {group.posts.map((post) => (
                <a
                        href={getPostUrlBySlug(post.slug)}
                        aria-label={post.data.title}
                        class="group btn-plain scale-animation block h-10 w-full rounded-lg hover:text-[initial] archive-item"
                        data-tags={(post.data.tags || []).join(",")}
                        data-category={post.data.category || ""}
                >
                    <div class="flex flex-row justify-start items-center h-full">
                        <!-- date -->
                        <div class="w-[15%] md:w-[10%] transition text-sm text-right text-50">
                            {formatDate(post.data.published)}
                        </div>

                        <!-- dot and line -->
                        <div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
                            <div
                                    class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5
                       bg-[oklch(0.5_0.05_var(--hue))] group-hover:bg-[var(--primary)]
                       outline outline-4 z-50
                       outline-[var(--card-bg)]
                       group-hover:outline-[var(--btn-plain-bg-hover)]
                       group-active:outline-[var(--btn-plain-bg-active)]"
                            ></div>
                        </div>

                        <!-- post title -->
                        <div
                                class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold
                     transition-all group-hover:text-[var(--primary)]
                     text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden"
                        >
                            {post.data.title}
                        </div>

                        <!-- tag list -->
                        <div
                                class="hidden md:block md:w-[15%] text-left text-sm transition
                     whitespace-nowrap overflow-ellipsis overflow-hidden text-30"
                        >
                            {formatTag(post.data.tags)}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    ))}
</div>

<script is:inline data-astro-rerun>
(function() {
    var params = new URLSearchParams(window.location.search);
    var tagFilter = params.has("tag") ? params.getAll("tag") : [];
    var categoryFilter = params.has("category") ? params.getAll("category") : [];
    var uncategorized = params.get("uncategorized");
    var hasFilter = tagFilter.length > 0 || categoryFilter.length > 0 || uncategorized;

    if (!hasFilter) return;

    var panel = document.getElementById("archive-panel");
    if (!panel) return;

    panel.querySelectorAll(".archive-item").forEach(function(item) {
        var tags = (item.dataset.tags || "").split(",").filter(Boolean);
        var cat = item.dataset.category;
        var show = true;
        if (tagFilter.length > 0) show = tagFilter.some(function(t) { return tags.indexOf(t) !== -1; });
        if (categoryFilter.length > 0) show = show && categoryFilter.indexOf(cat) !== -1;
        if (uncategorized) show = show && !cat;
        item.style.display = show ? "" : "none";
    });

    panel.querySelectorAll(".archive-group").forEach(function(group) {
        var vis = group.querySelectorAll('.archive-item:not([style*="display: none"])');
        var countEl = group.querySelector(".archive-year-posts-count");
        if (countEl) {
            var count = vis.length;
            var singular = panel.dataset.i18nSingular;
            var plural = panel.dataset.i18nPlural;
            countEl.textContent = count + " " + (count === 1 ? singular : plural);
        }
        group.style.display = vis.length > 0 ? "" : "none";
    });
})();
</script>
